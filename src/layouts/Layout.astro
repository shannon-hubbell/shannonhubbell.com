---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import HeaderBar from "../components/HeaderBar.astro";
import FooterBar from "../components/FooterBar.astro";
import GtmHeader from "../components/GtmHeader.astro";

interface Props {
	frontmatter?: {
		title?: string;
		description?: string;
		[key: string]: unknown;
	};
	pageTitle?: string;
	pageDescription?: string;
	pageClasses?: string | string[];
}

const { frontmatter } = Astro.props;

const title =
	frontmatter?.title ?? Astro.props.pageTitle ?? "Shannon Ellery Hubbell";
const description =
	frontmatter?.description ??
	Astro.props.pageDescription ??
	"I build things for the internet, I write, and I am more enthusiastic about paleontology than a non-paleontologist adult should be.";
const classes = frontmatter?.classes ?? Astro.props.pageClasses;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<meta name="og:title" content={title} />
		<meta name="og:description" content={description} />
		<meta name="description" content={description} />

		<link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
		<link rel="icon" href="/img/favicon.ico" />

		<meta name="og:image" content="/img/headshot-share.jpg" />

		<link rel="canonical" href={Astro.url} />
		<meta name="og:url" content={Astro.url} />

		<meta name="og:site_name" content="Shannon Ellery Hubbell" />

		<meta name="author" content="Shannon Ellery Hubbll" />

		<meta name="twitter:card" content="summary_large_image" />
		<GtmHeader />

		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
	</head>
	<body class:list={classes}>
		<HeaderBar />
		<main>
			<slot />
		</main>
		<FooterBar />
	</body>
</html>

<style>
	main {
		width: 800px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		line-height: 1.5rem;
		text-wrap: pretty;
		border-top: 1px solid var(--color-highlight);
		h1 {
			line-height: 2.5rem;
		}
		h2 {
			color: #666;
		}
		h3 {
			margin: 1.5rem 0 0 0;
		}
		h4 {
			margin: 0;
			color: #666;
		}
		hr {
			margin: 3rem 0;
			color: var(--color-highlight);
		}
		ul {
			margin: 1rem 0 2rem 0;
		}
	}
</style>
