---
import shannonHeadshot from "../assets/sh-headshot.webp";
---

<header>
    <h1><a href="/">Shannon Ellery Hubbell</a></h1>
    <h2>Writer. Coder. Dinosaur&nbsp;aficionado.</h2>
    <ul class="menu">
        <li><a href="/" class="projects home">Home</a></li>
        <li>
            <a href="/resume/" class="resume">Resumé</a>
        </li>
        <li>
            <a href="/contact/" class="contact">Contact</a>
        </li>
        <li>
            <a
                href="https://www.linkedin.com/in/shannonhubbell/"
                target="_blank">LinkedIn</a
            >
        </li>
        <li>
            <a
                href="https://bsky.app/profile/brundlefly.bsky.social"
                target="_blank">Bluesky</a
            >
        </li>
        <li>
            <a href="https://www.instagram.com/shannonhubbell/" target="_blank"
                >Instagram</a
            >
        </li>
    </ul>
</header>

<style>
    header {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: 0 auto;
        padding: 1rem;
    }

    h1 {
        font-size: 2.5rem;
        margin: 0;
        a {
            color: #9f87af;
            text-decoration: none;
        }
    }

    h2 {
        color: #888;
        margin: 0;
        padding: 0.4rem 0 0 0;
    }

    ul.menu {
        list-style: none;
        display: flex;
        margin: 0;
        padding: 1rem 0;
        gap: 1rem;
        li {
            padding: 0 1rem 0 0;
            border-right: 1px solid #999;
            &:last-child {
                border-right: none;
            }
        }
        a {
            color: #888;
            &:hover {
                color: #000;
            }
        }
        @media screen and (width < 500px) {
            display: block;
            li {
                border-right: none;
            }
        }
    }
    body.home a.home,
    body.contact a.contact,
    body.resume a.resume {
        color: #000;
    }

</style>
