---
import { Image } from "astro:assets";
import shHeadshot from "../assets/sh-headshot.webp";
import MainMenu  from "../components/MainMenu.astro";

---

<header>
    
    <img src="/img/headshot.webp" class="align-right mug" />

    <div class="inner">
        <h1><a href="/">Shannon Ellery Hubbell</a></h1>
        <h2>Writer. Coder. Dinosaur&nbsp;aficionado.</h2>
        <MainMenu />
    </div>
</header>

<style>
    header {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: 0 auto;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }

    h1 {
        font-size: 2.5rem;
        margin: 0;
        a {
            color: var(--color-highlight);
            text-decoration: none;
        }
    }

    h2 {
        color: #CCC;
        margin: 0;
        padding: 0.4rem 0 0 0;
    }
    div.inner {
        vertical-align: middle;
        justify-content: center;
        width: calc(100% - 200px);
    }
    img.mug {
        border-radius: 50%;
        max-width: 150px;
        aspect-ratio: 1 /1;
        border: 10px solid var(--color-highlight);
    }
    @media screen and (width < 500px) {
        header {
            display: block;
        }
        div.inner {
            width: auto;
            text-align: ;
        }
        img.mug {
            max-width: 80%;
            margin: 0 auto;
        }
        h1 {
            font-size: 3rem;
        }
    }
</style>
