---
import Layout from "../../layouts/Layout.astro";

const title = "Shannon Hubbell's Portfolio";
const description =
    "I build things for the internet, I write, and I am more enthusiastic about paleontology than an adult should be.";
const classes = ["page", "portfolio"];
---

<Layout pageTitle={title} pageDescription={description} pageClasses={classes}>
    <section class="portfolio-grid">
        <header>
            <h1>Web &amp; Video Portfolio</h1>
        </header>
        <a
            href="https://www.youtube.com/watch?v=MXCVSs3d1bo"
            target="_blank"
            style="background-image: url(/portfolio-assets/autodesk/ar-video/thumb.webp)"
        >
            <article>
                <h2>Autodesk &amp; ASCE</h2>
                <p>
                    Documentary video about an educational augmented reality
                    collaboration between Autodesk and the American Society of
                    Civil Engineers.
                </p>
            </article>
        </a>
        <a
            href="https://www.adobe-audience-finder.com/"
            target="_blank"
            style="background-image: url(/portfolio-assets/adobe/audience-finder/thumb.webp)"
        >
            <article>
                <h2>Adobe</h2>
                <p>
                    A filterable and searchable directory of Adobe data
                    partners, built in Wordpress.
                </p>
            </article>
        </a>
        <a
            href="/portfolio/envase"
            style="background-image: url(/portfolio-assets/envase/thumb.webp)"
        >
            <article>
                <h2>Envase Lite: The Next-Gen App for Digital Drayage</h2>
                <p>
                    Marketing microsite for a cloud-based, comprehensive drayage
                    system.
                </p>
            </article>
        </a>
        <a
            href="/portfolio/cepheid"
            style="background-image: url(/portfolio-assets/cepheid/thumb.webp)"
        >
            <article>
                <h2>Cepheid</h2>
                <p>
                    Marketing microsite for a medical diagnostics company
                    specializing in DNA testing.
                </p>
            </article>
        </a>
        <a
            href="/portfolio/viewstream/paso-webinar"
            style="background-image: url(/portfolio-assets/viewstream/paso-webinar/thumb.webp)"
        >
            <article>
                <h2>Viewstream PASO Webinar</h2>
                <p>
                    Landing page for digital marketing framework webinar.
                </p>
            </article>
        </a>
        <a
            href="/portfolio/2goodcompany"
            style="background-image: url(/portfolio-assets/2goodcompany/thumb.webp)"
        >
            <article>
                <h2>Good Company Communications</h2>
                <p>
                    Website for a digital marketing, streaming, and live event
                    agency.
                </p>
            </article>
        </a>
        <a
            href="https://vimeo.com/44290726"
            target="_blank"
            style="background-image: url(/portfolio-assets/grover-cleveland/thumb.webp)"
        >
            <article>
                <h2>Grover Cleveland: Dinosaur Wrangler</h2>
                <p>
                    Trailer for the greatest movie never made. I wrote,
                    directed, edited, and created the flawless VFX for this.
                </p>
            </article>
        </a>
    </section>
</Layout>

<style>
    section.portfolio-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        header,
        a {
            background-color: #9f87af;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            width: 50%;
            aspect-ratio: 1;
        }
        header {
            background: #000;
            width: calc(50% - 2rem);
            border: 1rem solid var(--color-highlight);
            h1 {
                padding: 2rem;
                color:var(--color-highlight);
                font-weight: normal;
            }
        }
        a {
            position: relative;
            article {
                position: absolute;
                bottom: 0;
                padding: 1rem;
                width: calc(100% - 2rem);
                background: rgba(0, 0, 0, 0.5);
                backdrop-filter: blur(10px);
                h2 {
                    color: #fff;
                    margin: 0.5rem 0;
                    line-height: 1.7rem;
                    font-weight: normal;
                }
                p {
                    color: #fff;
                    max-height: 0;
                    overflow: hidden;
                    margin: 0;
                    opacity: 0;
                    transition: all 0.75s cubic-bezier(0, 1, 0, 1);
                }
            }
            &:hover {
                p {
                    max-height: 370px;
                    opacity: 1;
                    transition: all 0.5s ease-in-out;
                }
            }
        }
        @media screen and (width < 500px) {
            display: block;
            header,
            a {
                width: auto;
                display: block;
                article p {
                    max-height: 500px;
                    opacity: 1;
                }
            }
            
        }
    }
</style>
